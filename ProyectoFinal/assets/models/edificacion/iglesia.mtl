# iglesia.mtl - corregido para OpenGL
# Un material por objeto. Las texturas van en la carpeta maps/ junto al .obj
# Si tu imagen se llama distinto, cambia SOLO el nombre en la linea map_Kd

newmtl mat_muros
	Ns 10.0000
	Ka 1.0000 1.0000 1.0000
	Kd 1.0000 1.0000 1.0000
	Ks 0.0200 0.0200 0.0200
	Ke 0.0000 0.0000 0.0000
	d 1.0000
	illum 2
	map_Kd ../../textures/muro_iglesia.jpg

